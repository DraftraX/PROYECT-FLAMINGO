---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lockViewport?: boolean;
}

const {
  title = 'Flamingo Residencial — Preventa de Lotes de 160 m² y 200 m² | Entrega Inmediata',
  description = 'Aprovecha la preventa de Flamingo Residencial: Lotes de 160 m² y 200 m² con título de propiedad, agua, desagüe, alumbrado público y entrega inmediata. A solo 30 metros del Colegio Virgen Dolorosa.',
  lockViewport = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" translate="no" class="notranslate">
  <head>
    <meta charset="UTF-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/brandbook/isotipo-plum.svg" />
    <link
      rel="preload"
      href="/fonts/GeistaMond-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body
    class={lockViewport
      ? 'lock-viewport bg-[#0c1428] text-white'
      : 'bg-[#F2EBE1] text-[#3D3C3D] selection:bg-[#462939]/20 selection:text-[#462939]'}
  >
    <slot />
  </body>
</html>
