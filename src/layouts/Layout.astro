---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lockViewport?: boolean;
}

const {
  title = 'Inmobiliaria Flamingo — Proyecto Residencial Flamingo | Showroom Virtual 360°',
  description = 'Conoce Residencial Flamingo en Tumbes: explora el plano oficial de lotización y un recorrido conceptual 360° de interiores.',
  lockViewport = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logos/flamingo-logo.svg" />
  </head>
  <body class={lockViewport ? 'lock-viewport bg-neutral-950 text-white' : 'bg-neutral-950 text-white'}>
    <slot />
  </body>
</html>
