---
// Landing editorial de Residencial Flamingo, basada en el Brandbook 2026.
// Paleta: ciruela #462939 · beige #F2EBE1 · oliva #535906 · negro #3D3C3D.
// Tipografía: Geista Mond (títulos) + DM Sans (textos).

const central = { display: '+51 989 195 093', raw: '51989195093' };
const advisors = [
  { display: '940 152 191', raw: '51940152191' },
  { display: '942 710 250', raw: '51942710250' },
];
const waText = encodeURIComponent('Hola, quiero información sobre Residencial Flamingo.');
const wa = (raw: string) => `https://wa.me/${raw}?text=${waText}`;

const valores = [
  { n: '01', t: 'Integridad', d: 'Actuamos con principios y coherencia en cada etapa del proyecto.' },
  { n: '02', t: 'Confianza', d: 'Relaciones basadas en la seguridad y en condiciones claras.' },
  { n: '03', t: 'Formalidad', d: 'Gestión ordenada, respaldada por la claridad documental.' },
  { n: '04', t: 'Compromiso', d: 'Cumplimos lo que ofrecemos, con responsabilidad.' },
];

const pilares = [
  { t: 'Ubicación', d: 'Conectado con Tarapoto y abierto al paisaje de la Escalera.' },
  { t: 'Servicios', d: 'Agua, desagüe y alumbrado público.' },
  { t: 'Privacidad', d: 'Residencial cerrado con pórtico de ingreso.' },
  { t: 'Orden', d: 'Lotes de 160 y 200 m², con título de propiedad.' },
];

// Medidas referenciales, proyectadas sobre los lotes tipo del plano (8×20 y 10×20 m).
const prototipos = [
  { n: '01', lote: '8 × 20 m · 160 m²', area: '185 m²', pisos: '2 pisos + azotea', dorm: '3 dormitorios', extra: '1 cochera' },
  { n: '02', lote: '8 × 20 m · 160 m²', area: '205 m²', pisos: '2 pisos + rooftop', dorm: '3 dormitorios + estudio', extra: '1 cochera' },
  { n: '03', lote: '10 × 20 m · 200 m²', area: '245 m²', pisos: '2 pisos + rooftop', dorm: '4 dormitorios', extra: '2 cocheras' },
  { n: '04', lote: '10 × 20 m · 200 m²', area: '270 m²', pisos: '2 pisos + rooftop con pérgola', dorm: '4 dormitorios + terraza', extra: '2 cocheras' },
];

const nav = [
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#proyecto', label: 'Proyecto' },
  { href: '#modelos', label: 'Modelos' },
  { href: '#entorno', label: 'Entorno' },
];
---

<div class="fl-page">
  <header class="fl-hero">
    <img
      src="/brand/brandbook/atardecer-escalera.jpg"
      alt="Atardecer sobre la Cordillera Escalera, Tarapoto"
      class="fl-hero__img"
      fetchpriority="high"
    />
    <div class="fl-hero__shade" aria-hidden="true"></div>

    <nav class="fl-nav fl-wrap" aria-label="Principal">
      <a href="#inicio" class="fl-brand" aria-label="Flamingo Residencial, inicio">
        <img src="/brand/brandbook/bird-light.svg" alt="" class="fl-brand__bird" />
        <span class="fl-brand__text">
          <span class="fl-brand__name">FLAMINGO</span>
          <span class="fl-brand__sub">RESIDENCIAL</span>
        </span>
      </a>
      <div class="fl-nav__links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
      <a href="#contacto" class="fl-btn fl-btn--ghost">Agenda tu visita</a>
    </nav>

    <div id="inicio" class="fl-hero__body fl-wrap">
      <p class="fl-eyebrow fl-eyebrow--light">Tarapoto · San Martín · Perú</p>
      <h1 class="fl-hero__title">Una nueva forma de proyectarse en Tarapoto.</h1>
      <div class="fl-hero__foot">
        <p class="fl-hero__lead">
          Lotes urbanos independizados en un entorno residencial planificado, con vista a la Cordillera Escalera.
        </p>
        <a href="#proyecto" class="fl-btn fl-btn--solid">
          Conocer el proyecto
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </header>

  <main>
    <section class="fl-mantra fl-reveal">
      <img src="/brand/brandbook/bird-plum.svg" alt="" class="fl-mantra__bird" />
      <h2 class="fl-h2 fl-h2--xl">Una inversión que trasciende.</h2>
      <p class="fl-body fl-body--lg">
        Elegir un espacio propio va más allá de adquirir un terreno: es apostar por nuevas oportunidades, construir patrimonio y dar forma a nuevos proyectos de vida.
      </p>
    </section>

    <section id="nosotros" class="fl-section fl-section--flush-top">
      <div class="fl-wrap fl-split">
        <div class="fl-split__media fl-reveal">
          <img src="/drive/2d/vision-portico.webp" alt="Pórtico de ingreso de Residencial Flamingo al atardecer" loading="lazy" class="fl-photo fl-photo--tall" />
        </div>
        <div class="fl-split__text fl-reveal">
          <p class="fl-eyebrow">01 — ¿Quiénes somos?</p>
          <h2 class="fl-h2">Una visión que construye futuro.</h2>
          <p class="fl-body">
            Flamingo Residencial nace de la visión de empresarios con experiencia en otros sectores que identificaron en Tarapoto una oportunidad para desarrollar una propuesta inmobiliaria orientada a la planificación, la formalidad y la proyección patrimonial.
          </p>
          <p class="fl-body">
            Frente a un mercado donde muchos terrenos presentan limitaciones de servicios, documentación u orden del entorno, planteamos una alternativa para invertir con confianza y proyectar la construcción del futuro hogar.
          </p>
          <hr class="fl-rule" />
          <p class="fl-quote">Convertir un terreno en patrimonio.</p>
        </div>
      </div>
    </section>

    <section class="fl-section fl-section--plum">
      <div class="fl-wrap fl-duo">
        <div class="fl-reveal">
          <p class="fl-eyebrow fl-eyebrow--light">Misión</p>
          <p class="fl-statement">
            Ofrecer lotes urbanos independizados en un entorno residencial planificado, con formalidad, infraestructura y privacidad para invertir con confianza y construir el futuro en Tarapoto.
          </p>
        </div>
        <div class="fl-reveal">
          <p class="fl-eyebrow fl-eyebrow--light">Visión</p>
          <p class="fl-statement">
            Ser un referente inmobiliario en Tarapoto por impulsar un desarrollo residencial organizado y planificado, una alternativa de confianza para proyectarse hacia el futuro.
          </p>
        </div>
      </div>
    </section>

    <section class="fl-section">
      <div class="fl-wrap">
        <p class="fl-eyebrow">02 — Valores</p>
        <h2 class="fl-h2">Lo que nos sostiene.</h2>
        <div class="fl-values">
          {valores.map((v) => (
            <div class="fl-value fl-reveal">
              <p class="fl-value__n">{v.n}</p>
              <h3 class="fl-value__t">{v.t}</h3>
              <p class="fl-body fl-body--sm">{v.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="proyecto" class="fl-section fl-section--flush-top">
      <div class="fl-wrap">
        <p class="fl-eyebrow">03 — El residencial</p>
        <h2 class="fl-h2 fl-h2--narrow">Un entorno planificado, pensado para habitar.</h2>
        <div class="fl-gallery">
          <figure class="fl-reveal">
            <img src="/drive/2d/vision-avenue.webp" alt="Avenida principal con pistas, veredas y áreas verdes" loading="lazy" class="fl-photo" />
            <figcaption>Pistas, veredas y retiros</figcaption>
          </figure>
          <figure class="fl-reveal">
            <img src="/drive/2d/vision-park.webp" alt="Parque central con palmeras y jardines" loading="lazy" class="fl-photo" />
            <figcaption>Áreas verdes y parque central</figcaption>
          </figure>
        </div>
        <figure class="fl-film fl-reveal">
          <video
            src="/videos/flamingo-masterplan.mp4"
            poster="/videos/flamingo-masterplan.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Recorrido aéreo: del estado actual de los lotes al residencial proyectado"
          ></video>
          <figcaption>Del terreno actual al residencial proyectado · 68 lotes, 8 manzanas y parque central</figcaption>
        </figure>
        <div class="fl-pillars">
          {pilares.map((p) => (
            <div class="fl-reveal">
              <p class="fl-pillar__t">{p.t}</p>
              <p class="fl-body fl-body--sm">{p.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="modelos" class="fl-section fl-section--sand">
      <div class="fl-wrap">
        <div class="fl-head-row">
          <div>
            <p class="fl-eyebrow">04 — Modelos de casa</p>
            <h2 class="fl-h2">Arquitectura definida para el condominio.</h2>
          </div>
          <p class="fl-body fl-body--sm fl-head-row__aside">
            Cada modelo responde al mismo lenguaje: líneas sobrias, materiales nobles y luz natural.
          </p>
        </div>
        <div class="fl-models">
          {prototipos.map((p) => (
            <article class="fl-model fl-reveal">
              <img src={`/modelos/prototipo-${Number(p.n)}.jpg`} alt={`Prototipo ${p.n}, fachada`} loading="lazy" class="fl-model__img" />
              <div class="fl-model__body">
                <p class="fl-model__lot">{p.lote}</p>
                <h3 class="fl-model__name">Prototipo {p.n}</h3>
                <dl class="fl-model__specs">
                  <div><dt>Área techada</dt><dd>{p.area}</dd></div>
                  <div><dt>Niveles</dt><dd>{p.pisos}</dd></div>
                  <div><dt>Ambientes</dt><dd>{p.dorm}</dd></div>
                  <div><dt>Estacionamiento</dt><dd>{p.extra}</dd></div>
                </dl>
              </div>
            </article>
          ))}
        </div>
        <div class="fl-models__foot">
          <p class="fl-body fl-body--sm">Áreas referenciales. Solicita planos y precios de cada prototipo.</p>
          <a href={wa(central.raw)} class="fl-btn fl-btn--plum" target="_blank" rel="noopener">Solicitar planos</a>
        </div>
      </div>
    </section>

    <section id="entorno" class="fl-landscape">
      <img src="/tarapoto/cordillera-escalera-valle.webp" alt="Cordillera Escalera, Tarapoto" loading="lazy" class="fl-hero__img" />
      <div class="fl-landscape__shade" aria-hidden="true"></div>
      <div class="fl-wrap fl-landscape__body">
        <p class="fl-eyebrow fl-eyebrow--light">05 — El paisaje</p>
        <h2 class="fl-h2 fl-h2--xl fl-h2--light">Frente a la Cordillera Escalera.</h2>
        <p class="fl-body fl-body--light">El horizonte verde que acompaña cada atardecer en Tarapoto.</p>
      </div>
    </section>

    <section id="contacto" class="fl-contact fl-trama">
      <img src="/brand/brandbook/isotipo-light.svg" alt="" class="fl-contact__iso" />
      <h2 class="fl-h2 fl-h2--xl fl-h2--light">Elige dónde construir tu futuro.</h2>
      <p class="fl-body fl-body--light fl-body--lg">Agenda una visita guiada y conoce el residencial en persona.</p>
      <div class="fl-contact__actions">
        <a href={wa(central.raw)} class="fl-btn fl-btn--solid" target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
        <a href={`tel:+${central.raw}`} class="fl-btn fl-btn--ghost">{central.display}</a>
      </div>
      <p class="fl-contact__advisors">
        Asesores:
        {advisors.map((a, i) => (
          <>
            {i > 0 && ' · '}
            <a href={wa(a.raw)} target="_blank" rel="noopener">{a.display}</a>
          </>
        ))}
      </p>
    </section>
  </main>

  <footer class="fl-footer">
    <div class="fl-wrap fl-footer__row">
      <div class="fl-brand">
        <img src="/brand/brandbook/bird-light.svg" alt="" class="fl-brand__bird" />
        <span class="fl-brand__text">
          <span class="fl-brand__name">FLAMINGO</span>
          <span class="fl-brand__sub">RESIDENCIAL</span>
        </span>
      </div>
      <p>Inmobiliaria Flamingo · Prolongación Jr. Cuzco, Tarapoto</p>
      <a href="https://www.instagram.com/inmobiliaria.flamingo/" target="_blank" rel="noopener">@inmobiliaria.flamingo</a>
    </div>
  </footer>
</div>

<script>
  const els = document.querySelectorAll<HTMLElement>('.fl-reveal');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }),
      { rootMargin: '0px 0px -10% 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .fl-page {
    --plum: #462939;
    --plum-dark: #2e1b26;
    --beige: #f2ebe1;
    --sand: #ebe2d5;
    --olive: #535906;
    --ink: #3d3c3d;
    --rule: rgba(70, 41, 57, 0.2);
    --gutter: clamp(20px, 5vw, 72px);
    font-family: 'DM Sans', system-ui, sans-serif;
    color: var(--ink);
    background: var(--beige);
    -webkit-font-smoothing: antialiased;
  }
  .fl-wrap { max-width: 1280px; margin: 0 auto; padding-inline: var(--gutter); box-sizing: border-box; width: 100%; }

  /* Hero */
  .fl-hero { position: relative; min-height: max(760px, 100svh); display: flex; flex-direction: column; overflow: hidden; background: #2a1822; }
  .fl-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .fl-hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(42,24,34,.55) 0%, rgba(42,24,34,0) 28%, rgba(42,24,34,0) 55%, rgba(30,22,20,.7) 100%); }
  .fl-nav { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 28px; flex-wrap: wrap; }
  .fl-nav__links { display: flex; gap: 40px; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; }
  .fl-nav__links a { color: var(--beige); text-decoration: none; opacity: .9; transition: opacity .2s; }
  .fl-nav__links a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 6px; }
  .fl-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--beige); }
  .fl-brand__bird { height: 40px; width: auto; }
  .fl-brand__text { display: flex; flex-direction: column; line-height: 1; }
  .fl-brand__name { font-family: 'Geista Mond', Georgia, serif; font-size: 22px; letter-spacing: .04em; }
  .fl-brand__sub { font-size: 8px; letter-spacing: .62em; margin-top: 5px; }
  .fl-hero__body { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 72px; }
  .fl-hero__title { margin: 0; font-family: 'Geista Mond', Georgia, serif; font-weight: 400; font-size: clamp(44px, 6.4vw, 96px); line-height: 1.02; color: var(--beige); max-width: 900px; }
  .fl-hero__foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px; margin-top: 40px; }
  .fl-hero__lead { margin: 0; max-width: 460px; font-size: 17px; line-height: 1.6; color: rgba(242,235,225,.88); font-weight: 300; }

  /* Botones */
  .fl-btn { display: inline-flex; align-items: center; gap: 14px; min-height: 52px; padding: 0 30px; border-radius: 999px; text-decoration: none; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; transition: background .2s, color .2s; }
  .fl-btn--solid { background: var(--beige); color: var(--plum); font-weight: 500; }
  .fl-btn--solid:hover { background: #fff; }
  .fl-btn--ghost { min-height: 44px; padding: 0 22px; border: 1px solid rgba(242,235,225,.7); color: var(--beige); }
  .fl-btn--ghost:hover { background: rgba(242,235,225,.12); }

  /* Tipografía */
  .fl-eyebrow { margin: 0; font-size: 12px; letter-spacing: .32em; text-transform: uppercase; color: var(--olive); }
  .fl-eyebrow--light { color: rgba(242,235,225,.78); }
  .fl-h2 { margin: 24px 0 0; font-family: 'Geista Mond', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6vw, 52px); line-height: 1.1; color: var(--plum); }
  .fl-h2--xl { font-size: clamp(36px, 4.6vw, 64px); line-height: 1.06; }
  .fl-h2--narrow { max-width: 760px; }
  .fl-h2--light { color: var(--beige); }
  .fl-body { margin: 20px 0 0; font-size: 17px; line-height: 1.75; font-weight: 300; }
  .fl-body--lg { font-size: 18px; line-height: 1.7; }
  .fl-body--sm { font-size: 15px; line-height: 1.7; margin-top: 12px; }
  .fl-body--light { color: rgba(242,235,225,.86); }
  .fl-statement { margin: 28px 0 0; font-family: 'Geista Mond', Georgia, serif; font-size: clamp(24px, 2.4vw, 32px); line-height: 1.35; }
  .fl-quote { margin: 0; font-family: 'Geista Mond', Georgia, serif; font-size: 22px; line-height: 1.4; color: var(--plum); }
  .fl-rule { border: 0; height: 1px; background: var(--rule); margin: 40px 0 28px; }

  /* Secciones */
  .fl-section { padding-block: clamp(96px, 10vw, 144px); }
  .fl-section--flush-top { padding-top: 0; }
  .fl-section--plum { background: var(--plum); color: var(--beige); }
  .fl-section--sand { background: var(--sand); }
  .fl-mantra { padding: clamp(96px, 12vw, 168px) var(--gutter); text-align: center; }
  .fl-mantra__bird { height: 72px; width: auto; }
  .fl-mantra .fl-h2 { margin: 36px auto 0; max-width: 820px; }
  .fl-mantra .fl-body { margin: 28px auto 0; max-width: 620px; }

  .fl-split { display: flex; flex-wrap: wrap; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .fl-split__media { flex: 1 1 480px; min-width: 0; }
  .fl-split__text { flex: 1 1 420px; min-width: 0; }
  .fl-photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; display: block; }
  .fl-photo--tall { aspect-ratio: 4 / 5; }

  .fl-duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(48px, 6vw, 112px); }

  .fl-values { margin-top: 64px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); border-top: 1px solid var(--rule); }
  .fl-value { padding: 36px 32px 36px 0; border-bottom: 1px solid var(--rule); }
  .fl-value__n { margin: 0; font-family: 'Geista Mond', Georgia, serif; font-size: 15px; color: var(--olive); }
  .fl-value__t { margin: 20px 0 0; font-family: 'Geista Mond', Georgia, serif; font-weight: 400; font-size: 28px; color: var(--plum); }

  .fl-gallery { margin-top: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 24px; }
  .fl-gallery figure { margin: 0; }
  .fl-gallery figcaption { margin-top: 16px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--plum); }
  .fl-film { margin: 72px 0 0; }
  .fl-film video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; display: block; background: var(--plum-dark); }
  .fl-film figcaption { margin-top: 16px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--plum); }
  .fl-pillars { margin-top: 72px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; }
  .fl-pillar__t { margin: 0; font-family: 'Geista Mond', Georgia, serif; font-size: 24px; color: var(--plum); }

  .fl-head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .fl-head-row__aside { max-width: 360px; margin: 0; }
  .fl-models { margin-top: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 24px; }
  .fl-model { background: var(--beige); border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; }
  .fl-model__img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; }
  .fl-model__body { padding: 28px; }
  .fl-model__lot { margin: 0; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--olive); }
  .fl-model__name { margin: 12px 0 0; font-family: 'Geista Mond', Georgia, serif; font-weight: 400; font-size: 28px; color: var(--plum); }
  .fl-model__specs { margin: 20px 0 0; display: grid; gap: 10px; }
  .fl-model__specs div { display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid var(--rule); padding-top: 10px; font-size: 14px; }
  .fl-model__specs dt { color: rgba(61,60,61,.75); }
  .fl-model__specs dd { margin: 0; text-align: right; color: var(--ink); }
  .fl-models__foot { margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; }
  .fl-models__foot .fl-body { margin: 0; }
  .fl-btn--plum { background: var(--plum); color: var(--beige); font-weight: 500; }
  .fl-btn--plum:hover { background: #5a3649; }

  .fl-trama { background-image: url('/brand/brandbook/trama-tile.svg'); background-size: 120px 120px; }

  .fl-landscape { position: relative; min-height: 720px; overflow: hidden; display: flex; align-items: flex-end; }
  .fl-landscape__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(42,24,34,0) 35%, rgba(42,24,34,.78) 100%); }
  .fl-landscape__body { position: relative; padding-bottom: 72px; }
  .fl-landscape__body .fl-h2 { max-width: 760px; margin-top: 20px; }
  .fl-landscape__body .fl-body { max-width: 520px; }

  .fl-contact { background-color: var(--plum); color: var(--beige); padding: clamp(96px, 11vw, 160px) var(--gutter); text-align: center; }
  .fl-contact__iso { height: 96px; width: auto; }
  .fl-contact .fl-h2 { margin: 36px auto 0; max-width: 760px; }
