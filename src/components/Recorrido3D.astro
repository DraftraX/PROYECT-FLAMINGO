---
// Recorrido 3D de todo Residencial Flamingo, exportado desde Blender (public/proyecto3d).
import RecorridoVirtual from './RecorridoVirtual.astro';
const paradas = [
  { id: 'aerea', label: 'Vista aérea' },
  { id: 'portico', label: 'Pórtico' },
  { id: 'ingreso', label: 'Ingreso' },
  { id: 'plaza', label: 'Plaza central' },
  { id: 'pergola', label: 'Pérgola' },
];
---

<div class="r3d" data-r3d>
  <div class="r3d__stage" data-stage tabindex="0" aria-label="Recorrido 3D del residencial. Arrastra para mirar; en modo caminar usa W A S D o las flechas para moverte.">
    <div class="r3d__loading" data-loading>
      <img src="/brand/brandbook/isotipo-light.svg" alt="" />
      <span>Cargando el residencial… <b data-pct>0%</b></span>
    </div>

    <div class="r3d__top">
      <div class="r3d__modes" role="group" aria-label="Modo de recorrido">
        <button type="button" data-mode="orbit" aria-pressed="true">Vista aérea</button>
        <button type="button" data-mode="walk" aria-pressed="false">Caminar</button>
      </div>
      <button type="button" class="r3d__icon" data-full aria-label="Pantalla completa">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
      </button>
    </div>

    <div class="r3d__stops" role="group" aria-label="Ir a">
      {paradas.map((p) => <button type="button" data-stop={p.id}>{p.label}</button>)}
    </div>

    <div class="r3d__pad" data-pad hidden>
      <button type="button" data-move="f" aria-label="Avanzar"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 5l-6 7h12z"></path></svg></button>
      <button type="button" data-move="l" aria-label="Izquierda"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12l7-6v12z"></path></svg></button>
      <button type="button" data-move="b" aria-label="Retroceder"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 19l6-7H6z"></path></svg></button>
      <button type="button" data-move="r" aria-label="Derecha"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 12l-7 6V6z"></path></svg></button>
    </div>

    <p class="r3d__hint" data-hint>Arrastra para girar · rueda para acercar</p>

    <button type="button" class="r3d__enter" data-enter hidden>
      <img src="/brand/iconos/portico.svg" alt="" width="34" height="34" />
      <span><b data-enter-label>Entrar a la casa</b><small data-enter-sub>Tecla E</small></span>
    </button>
  </div>

  <dialog class="r3d__dialog" data-dialog aria-labelledby="r3d-dialog-t">
    <div class="r3d__dialog-head">
      <div>
        <p class="fl-eyebrow">Recorrido interior</p>
        <h2 id="r3d-dialog-t" class="fl-h3" data-dialog-title>Prototipo</h2>
      </div>
      <button type="button" class="r3d__close" data-close aria-label="Salir de la casa y volver al recorrido">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        <span>Volver a la calle</span>
      </button>
    </div>
    <RecorridoVirtual />
  </dialog>
</div>

<script>
  type V3 = [number, number, number];
  type Escena = { casas: { p: number; pos: V3; rot: number; sx: number; sz: number }[]; poi: Record<string, { pos: V3; look: V3 }>; centro: V3 };

  async function init(root: HTMLElement) {
    const THREE = await import('three');
    const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');
    const { crearTexturas, texturizar, triplanar } = await import('../scripts/texturas');

    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const loadingEl = root.querySelector<HTMLElement>('[data-loading]')!;
    const pctEl = root.querySelector<HTMLElement>('[data-pct]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const pad = root.querySelector<HTMLElement>('[data-pad]')!;
    const modeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.domElement.className = 'r3d__canvas';
    stage.prepend(renderer.domElement);

    const scene = new THREE.Scene();
    const horizon = new THREE.Color('#e7c9b8');
    scene.fog = new THREE.Fog(horizon, 180, 900);

    // Cielo de atardecer en los colores de la marca
    const sky = new THREE.Mesh(
      new THREE.SphereGeometry(1500, 32, 16),
      new THREE.ShaderMaterial({
        side: THREE.BackSide, depthWrite: false, fog: false,
        uniforms: { top: { value: new THREE.Color('#5a3a4c') }, mid: { value: new THREE.Color('#b98a92') }, bottom: { value: horizon } },
        vertexShader: 'varying vec3 vP; void main(){ vP = normalize(position); gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }',
        fragmentShader: 'uniform vec3 top; uniform vec3 mid; uniform vec3 bottom; varying vec3 vP; void main(){ float h = vP.y; vec3 c = h < 0.12 ? mix(bottom, mid, smoothstep(0.0, 0.12, h)) : mix(mid, top, smoothstep(0.12, 0.6, h)); gl_FragColor = vec4(c, 1.0); }',
      }),
    );
    scene.add(sky);

    // Luz cálida de atardecer + entorno para reflejos en vidrio y metal
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    scene.environmentIntensity = 0.45;
    scene.add(new THREE.HemisphereLight('#e4e6ef', '#4f5b2c', 0.85));
    const sun = new THREE.DirectionalLight('#ffd7b0', 2.8);
    sun.position.set(-140, 120, 110);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    Object.assign(sun.shadow.camera, { left: -170, right: 170, top: 170, bottom: -170, near: 10, far: 500 });
    sun.shadow.bias = -0.0006;
    scene.add(sun);

    // Suelo amplio alrededor del sitio
    const tx = crearTexturas(THREE);
    const groundMat = new THREE.MeshStandardMaterial({ roughness: 1 });
    triplanar(groundMat, tx.pasto, 0.05);
    groundMat.color.set('#c9d6b4');
    const ground = new THREE.Mesh(new THREE.CircleGeometry(1400, 48), groundMat);
    ground.rotation.x = -Math.PI / 2; ground.position.y = -0.09; ground.receiveShadow = true;
    scene.add(ground);

    const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 3000);
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true; controls.dampingFactor = 0.07;
    controls.maxPolarAngle = Math.PI * 0.47; controls.minDistance = 25; controls.maxDistance = 520;

    // Carga
    const manager = new THREE.LoadingManager();
    manager.onProgress = (_u, done, total) => { pctEl.textContent = `${Math.round((done / total) * 100)}%`; };
    const loader = new GLTFLoader(manager);
    const data: Escena = await (await fetch('/proyecto3d/escena.json')).json();
    const load = (url: string) => new Promise<any>((res, rej) => loader.load(url, res, (e) => {
      if (url.includes('sitio') && e.total) pctEl.textContent = `${Math.round((e.loaded / e.total) * 100)}%`;
    }, rej));
    const prep = (obj: any, cast: boolean) => obj.traverse((o: any) => {
      if (o.isMesh) {
        o.castShadow = cast; o.receiveShadow = true;
        const m = o.material; if (m && m.transparent) { m.depthWrite = false; o.castShadow = false; }
      }
    });
    const [sitio, ...protos] = await Promise.all(['/proyecto3d/sitio.glb', 1, 2, 3, 4].map((u) => load(typeof u === 'number' ? `/proyecto3d/prototipo-${u}.glb` : u)));
    prep(sitio.scene, true); scene.add(sitio.scene);
    const texturizados = texturizar(sitio.scene, tx);
    protos.forEach((g) => { prep(g.scene, true); texturizar(g.scene, tx, texturizados); });

    // Puerta peatonal de cada prototipo, en coordenadas locales de la casa (m).
    // Mismo cálculo que el modelado en Blender: cochera a la derecha, ingreso a la izquierda.
    const doorX = (w: number) => {
      const gx0 = w - 0.2 - (w < 9 ? 3.2 : 5.4);
      const split = 0.2 + (gx0 - 0.55 - 0.2) * 0.55;
      return split + 0.75;
    };
    const anchoProto = [8, 8, 10, 10];
    const markerMat = new THREE.MeshBasicMaterial({ color: '#d7dc8a', transparent: true, opacity: 0.85, depthWrite: false });
    const markerGeo = new THREE.RingGeometry(0.42, 0.6, 40).rotateX(-Math.PI / 2);
    type Puerta = { p: number; lote: number; pos: any; casa: any };
    const puertas: Puerta[] = [];
    const casas: any[] = [];
    data.casas.forEach((c, i) => {
      const h = protos[c.p - 1].scene.clone();
      h.position.set(...c.pos);
      h.rotation.y = c.rot;
      h.scale.set(c.sx, 1, c.sz);
      h.userData = { p: c.p, lote: i + 1 };
      scene.add(h);
      casas.push(h);
      const ring = new THREE.Mesh(markerGeo, markerMat);
      ring.position.set(doorX(anchoProto[c.p - 1]), 0.14, 0.9);
      h.add(ring);
      h.updateMatrixWorld(true);
      puertas.push({ p: c.p, lote: i + 1, pos: ring.getWorldPosition(new THREE.Vector3()), casa: h });
    });
    loadingEl.hidden = true;

    // ---- Entrar a la casa
    const enterBtn = root.querySelector<HTMLButtonElement>('[data-enter]')!;
    const enterLabel = root.querySelector<HTMLElement>('[data-enter-label]')!;
    const dialog = root.querySelector<HTMLDialogElement>('[data-dialog]')!;
    const dialogTitle = root.querySelector<HTMLElement>('[data-dialog-title]')!;
    const rv = dialog.querySelector<HTMLElement>('[data-rv]')!;
    let candidata: Puerta | null = null;
    let fuente: 'cerca' | 'clic' = 'cerca';
    let enCasa = false;
    const ofrecer = (pt: Puerta | null, src: 'cerca' | 'clic' = 'cerca') => {
      candidata = pt; fuente = src;
      enterBtn.hidden = !pt;
      if (pt) {
        enterLabel.textContent = `Entrar al Prototipo 0${pt.p}`;
        root.querySelector<HTMLElement>('[data-enter-sub]')!.textContent = `Lote ${String(pt.lote).padStart(2, '0')} · tecla E`;
      }
    };
    const entrar = () => {
      if (!candidata) return;
      enCasa = true; keys.clear();
      dialogTitle.textContent = `Prototipo 0${candidata.p} · Lote ${String(candidata.lote).padStart(2, '0')}`;
      rv.dataset.start = String(candidata.p);
      dialog.showModal();
      rv.dispatchEvent(new CustomEvent('rv:go', { detail: candidata.p }));
    };
    enterBtn.addEventListener('click', entrar);
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { enCasa = false; stage.focus(); });
    stage.addEventListener('keydown', (e) => { if (e.key.toLowerCase() === 'e') entrar(); });

    // Clic sobre una casa: la elige como destino (en cualquier modo)
    const ray = new THREE.Raycaster(); const ndc = new THREE.Vector2();
    let downX = 0, downY = 0;
    renderer.domElement.addEventListener('pointerdown', (e) => { downX = e.clientX; downY = e.clientY; });
    renderer.domElement.addEventListener('pointerup', (e) => {
      if (Math.hypot(e.clientX - downX, e.clientY - downY) > 5) return;
      const r = renderer.domElement.getBoundingClientRect();
      ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
      ray.setFromCamera(ndc, camera);
      const hit = ray.intersectObjects(casas, true)[0];
      if (!hit) return;
      let o: any = hit.object; while (o && !o.userData.p) o = o.parent;
      const pt = puertas.find((d) => d.casa === o);
      if (pt) ofrecer(pt, 'clic');
    });

    // ---- Modos y recorrido
    let mode: 'orbit' | 'walk' = 'orbit';
    let yaw = 0, pitch = 0;
    const eye = 1.75;
    const keys = new Set<string>();
    const centro = new THREE.Vector3(...data.centro);
    let tween: { t: number; from: any; to: any; lf: any; lt: any } | null = null;

    function setMode(m: 'orbit' | 'walk') {
      mode = m;
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
      controls.enabled = m === 'orbit';
      pad.hidden = m !== 'walk';
      hint.textContent = m === 'walk' ? 'Arrastra para mirar · W A S D o flechas para caminar' : 'Arrastra para girar · rueda para acercar';
      if (m === 'walk') {
        if (camera.position.y > 20) go('ingreso');
        const d = new THREE.Vector3(); camera.getWorldDirection(d);
        yaw = Math.atan2(-d.x, -d.z); pitch = 0;
      } else {
        controls.target.copy(centro);
      }
    }

    function go(id: string) {
      const p = data.poi[id]; if (!p) return;
      const to = new THREE.Vector3(...p.pos), lt = new THREE.Vector3(...p.look);
      const lf = new THREE.Vector3(); camera.getWorldDirection(lf); lf.multiplyScalar(30).add(camera.position);
      if (mode === 'orbit') lf.copy(controls.target);
      tween = { t: 0, from: camera.position.clone(), to, lf, lt };
      if (id !== 'aerea' && mode !== 'walk') { mode = 'walk'; modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === 'walk'))); controls.enabled = false; pad.hidden = false; hint.textContent = 'Arrastra para mirar · W A S D o flechas para caminar'; }
      if (id === 'aerea') { mode = 'orbit'; modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === 'orbit'))); pad.hidden = true; }
    }

    modeBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as 'orbit' | 'walk')));
    root.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => b.addEventListener('click', () => go(b.dataset.stop!)));

    // Mirar arrastrando en modo caminar
    let drag = false, lx = 0, ly = 0;
    renderer.domElement.addEventListener('pointerdown', (e) => { drag = true; lx = e.clientX; ly = e.clientY; hint.hidden = true; });
    window.addEventListener('pointerup', () => { drag = false; });
    renderer.domElement.addEventListener('pointermove', (e) => {
      if (!drag || mode !== 'walk' || tween) return;
      yaw -= (e.clientX - lx) * 0.0035; pitch = THREE.MathUtils.clamp(pitch - (e.clientY - ly) * 0.0035, -1.2, 1.2);
      lx = e.clientX; ly = e.clientY;
    });
    stage.addEventListener('keydown', (e) => {
      const k = e.key.toLowerCase();
      if (['w', 'a', 's', 'd', 'arrowup', 'arrowdown', 'arrowleft', 'arrowright', 'shift'].includes(k)) {
        keys.add(k); if (k.startsWith('arrow')) e.preventDefault();
        if (mode !== 'walk' && k !== 'shift') setMode('walk');
      }
    });
    stage.addEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));
    stage.addEventListener('blur', () => keys.clear());
    // Controles táctiles
    pad.querySelectorAll<HTMLButtonElement>('[data-move]').forEach((b) => {
      const k = { f: 'w', b: 's', l: 'a', r: 'd' }[b.dataset.move as 'f' | 'b' | 'l' | 'r'];
      const on = (e: Event) => { e.preventDefault(); keys.add(k); };
      const off = () => keys.delete(k);
      b.addEventListener('pointerdown', on); b.addEventListener('pointerup', off); b.addEventListener('pointerleave', off); b.addEventListener('pointercancel', off);
    });

    root.querySelector<HTMLButtonElement>('[data-full]')!.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen(); else stage.requestFullscreen?.();
    });

    function resize() {
      const w = stage.clientWidth, h = stage.clientHeight;
      renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(stage); resize();

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(stage);

    go('aerea'); tween!.t = 1; camera.position.copy(tween!.to); controls.target.copy(centro); tween = null;

    const clock = new THREE.Clock();
    const fwd = new THREE.Vector3(), side = new THREE.Vector3(), look = new THREE.Vector3();
    renderer.setAnimationLoop(() => {
      const dt = Math.min(clock.getDelta(), 0.05);
      if (!visible || enCasa) return;
      markerMat.opacity = 0.55 + Math.sin(clock.elapsedTime * 3) * 0.3;
      if (tween) {
        tween.t = Math.min(1, tween.t + dt / 1.6);
        const k = tween.t < 0.5 ? 4 * tween.t ** 3 : 1 - (-2 * tween.t + 2) ** 3 / 2;
        camera.position.lerpVectors(tween.from, tween.to, k);
        look.lerpVectors(tween.lf, tween.lt, k);
        camera.lookAt(look);
        if (tween.t >= 1) {
          if (mode === 'orbit') { controls.target.copy(centro); }
          else { const d = new THREE.Vector3().subVectors(tween.lt, tween.to); yaw = Math.atan2(-d.x, -d.z); pitch = Math.atan2(d.y, Math.hypot(d.x, d.z)); }
          tween = null;
        }
      } else if (mode === 'walk') {
        const speed = (keys.has('shift') ? 9 : 4.2) * dt;
        fwd.set(-Math.sin(yaw), 0, -Math.cos(yaw)); side.set(-fwd.z, 0, fwd.x);
        if (keys.has('w') || keys.has('arrowup')) camera.position.addScaledVector(fwd, speed);
        if (keys.has('s') || keys.has('arrowdown')) camera.position.addScaledVector(fwd, -speed);
        if (keys.has('arrowleft')) yaw += 1.6 * dt;
        if (keys.has('arrowright')) yaw -= 1.6 * dt;
        if (keys.has('a')) camera.position.addScaledVector(side, -speed);
        if (keys.has('d')) camera.position.addScaledVector(side, speed);
        camera.position.y = THREE.MathUtils.lerp(camera.position.y, eye, 0.2);
        const off = camera.position.clone().sub(centro); off.y = 0;
        if (off.length() > 260) { off.setLength(260); camera.position.x = centro.x + off.x; camera.position.z = centro.z + off.z; }
        look.set(Math.sin(yaw + Math.PI) * Math.cos(pitch), Math.sin(pitch), Math.cos(yaw + Math.PI) * Math.cos(pitch)).add(camera.position);
        camera.lookAt(look);
        // Puerta más cercana a menos de 5 m: ofrecer entrar
        let best: Puerta | null = null, bd = 5;
        for (const d of puertas) {
          const dist = Math.hypot(d.pos.x - camera.position.x, d.pos.z - camera.position.z);
          if (dist < bd) { bd = dist; best = d; }
        }
        const moving = ['w', 'a', 's', 'd', 'arrowup', 'arrowdown'].some((k) => keys.has(k));
        if (best && best !== candidata) ofrecer(best, 'cerca');
        else if (!best && candidata && (fuente === 'cerca' || moving)) ofrecer(null);
      } else {
        controls.update();
      }
      renderer.render(scene, camera);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-r3d]').forEach((root) => {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { io.disconnect(); init(root).catch((err) => { console.error(err); root.querySelector('[data-loading] span')!.textContent = 'No se pudo cargar el recorrido 3D.'; }); }
    }, { rootMargin: '200px 0px' });
    io.observe(root);
  });
</script>

<style>
  .r3d__stage { position: relative; width: 100%; height: min(82vh, 820px); min-height: 520px; overflow: hidden; border-radius: 4px; background: #2e1b26; outline: none; touch-action: none; }
  .r3d__stage:focus-visible { box-shadow: 0 0 0 3px var(--olive); }
  .r3d__stage:fullscreen { border-radius: 0; height: 100vh; }
  :global(.r3d__canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .r3d__loading { position: absolute; inset: 0; z-index: 5; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px; background: var(--plum); color: var(--beige); font-size: 14px; letter-spacing: .12em; text-transform: uppercase; }
  .r3d__loading[hidden] { display: none; }
  .r3d__loading img { height: 84px; animation: r3d-pulse 1.6s ease-in-out infinite; }
  @keyframes r3d-pulse { 50% { opacity: .45; } }
  .r3d__top { position: absolute; z-index: 3; top: 16px; left: 16px; right: 16px; display: flex; justify-content: space-between; gap: 12px; pointer-events: none; }
  .r3d__top > * { pointer-events: auto; }
  .r3d__modes { display: inline-flex; padding: 4px; border-radius: 999px; background: rgba(46,27,38,.78); backdrop-filter: blur(6px); }
  .r3d__modes button, .r3d__stops button { min-height: 40px; padding: 0 16px; border: 0; border-radius: 999px; background: transparent; color: var(--beige); font: inherit; font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .r3d__modes button[aria-pressed='true'] { background: var(--beige); color: var(--plum); }
  .r3d__icon { width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(46,27,38,.78); color: var(--beige); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .r3d__stops { position: absolute; z-index: 3; left: 16px; bottom: 16px; display: flex; flex-wrap: wrap; gap: 8px; max-width: calc(100% - 200px); }
  .r3d__stops button { background: rgba(83,89,6,.88); min-height: 44px; }
  .r3d__stops button:hover { background: var(--olive); }
  .r3d__pad { position: absolute; z-index: 3; right: 16px; bottom: 16px; display: grid; grid-template-columns: repeat(3, 48px); grid-template-rows: repeat(2, 48px); gap: 6px; }
  .r3d__pad[hidden] { display: none; }
  .r3d__pad button { border: 0; border-radius: 10px; background: rgba(46,27,38,.78); color: var(--beige); display: flex; align-items: center; justify-content: center; cursor: pointer; touch-action: none; }
  .r3d__pad [data-move='f'] { grid-column: 2; grid-row: 1; }
