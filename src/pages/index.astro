---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icono from '../components/Icono.astro';
import MasterPlan from '../components/MasterPlan.astro';
import { contacto, whatsapp } from '../config/site';
import { atributosLanding, googleMapsUrl } from '../config/landing';
import '../styles/landing.css';

const visita = '/contacto#formulario';
const valores = [
  { titulo: 'Integridad', texto: 'Actuamos con principios y coherencia en cada etapa del proyecto, manteniendo una conducta responsable y respetuosa hacia nuestros clientes. Buscamos que cada decisión refleje el compromiso de hacer las cosas correctamente.' },
  { titulo: 'Confianza', texto: 'Construimos relaciones basadas en la seguridad y tranquilidad de nuestros clientes, ofreciendo una propuesta inmobiliaria con condiciones claras que les permita tomar decisiones de inversión con mayor seguridad.' },
  { titulo: 'Formalidad', texto: 'Promovemos una gestión inmobiliaria ordenada y responsable, respaldada por la claridad documental y el cumplimiento de las condiciones establecidas para el desarrollo del proyecto.' },
  { titulo: 'Compromiso', texto: 'Trabajamos con responsabilidad para cumplir con lo que ofrecemos, procurando que cada aspecto del proyecto responda a las expectativas de nuestros clientes y a nuestra visión de desarrollo residencial.' },
];
const conceptos = [
  { titulo: 'Planificación urbana', texto: 'Organización aprobada de vías y demás componentes urbanos contemplados en el proyecto.' },
  { titulo: 'Formalidad registral', texto: 'Inscripción de la habilitación urbana en Registros Públicos.' },
  { titulo: 'Decisión informada', texto: 'Posibilidad de revisar la documentación urbanística y registral antes de adquirir una propiedad.' },
];
---

<SiteLayout landing prefooter={false} title="Flamingo Residencial · Una nueva forma de proyectarse en Tarapoto" description="Un proyecto residencial con respaldo urbanístico y registral, planificación integral y vistas a la Cordillera Escalera. Explora el Master Plan de Flamingo Residencial.">
  <div class="landing">
    <section id="inicio" class="landing-hero" aria-labelledby="inicio-titulo">
      <img class="landing-hero__image" src="/landing/avenida-hacia-plaza.webp"
        srcset="/landing/avenida-hacia-plaza-900.webp 900w, /landing/avenida-hacia-plaza.webp 1672w" sizes="100vw"
        width="1672" height="941" alt="" fetchpriority="high" />
      <div class="fl-wrap landing-hero__content">
        <h1 id="inicio-titulo" class="fl-h1">Una nueva forma de proyectarse en Tarapoto.</h1>
        <p>Un proyecto residencial con respaldo urbanístico y registral, planificación integral y vistas a la Cordillera Escalera.</p>
        <div class="landing-hero__actions">
          <a href="#master-plan" class="fl-btn fl-btn--solid">Explora el Master Plan <span aria-hidden="true">↓</span></a>
          <a href={visita} class="fl-btn fl-btn--ghost">Agenda tu visita</a>
        </div>
      </div>
      <span class="landing-hero__credit">Render referencial</span>
    </section>

    <section id="nosotros" aria-labelledby="nosotros-titulo">
      <div class="fl-wrap landing-band landing-split landing-history">
        <div class="landing-copy">
          <p class="landing-label">Nosotros</p>
          <h2 class="fl-h2" id="nosotros-titulo">Una visión que construye futuro</h2>
          <p>Flamingo Residencial nace a partir de la visión de empresarios con experiencia en otros sectores que identificaron en Tarapoto una oportunidad para desarrollar una propuesta inmobiliaria orientada a la planificación, la formalidad y la proyección patrimonial.</p>
          <p>Frente a un mercado en el que muchos terrenos pueden presentar limitaciones relacionadas con el acceso a servicios básicos, la documentación o la organización del entorno, Flamingo Residencial plantea una alternativa para quienes buscan invertir con mayor confianza y proyectar la construcción de su futuro hogar.</p>
          <p>El proyecto reúne lotes urbanos independizados y busca contribuir al desarrollo residencial de Tarapoto mediante una alternativa que valore tanto la inversión como la tranquilidad de contar con condiciones claras para construir.</p>
          <p>Así, Flamingo Residencial representa una forma de mirar hacia el futuro: invertir en un espacio propio, con una visión de crecimiento y la posibilidad de convertir un terreno en patrimonio.</p>
        </div>
        <figure class="landing-photo">
          <img src="/landing/avenida-hacia-portico.webp" width="1672" height="941" loading="lazy" decoding="async" alt="Avenida interna en dirección al pórtico de Flamingo Residencial" />
          <figcaption>Render referencial</figcaption>
        </figure>
      </div>

      <div class="landing-mission">
        <article class="landing-plum landing-pattern">
          <h3 class="fl-h2">Misión</h3>
          <p>Ofrecer lotes urbanos independizados en un entorno residencial planificado, brindando condiciones de formalidad, infraestructura y privacidad que permitan a nuestros clientes invertir con confianza y construir su futuro en Tarapoto.</p>
        </article>
        <article class="landing-olive landing-pattern">
          <h3 class="fl-h2">Visión</h3>
          <p>Ser un referente inmobiliario en Tarapoto por impulsar un desarrollo residencial organizado y planificado, consolidándonos como una alternativa de confianza para quienes buscan invertir, construir su patrimonio y proyectarse hacia el futuro.</p>
        </article>
      </div>

      <div class="landing-pattern">
        <div class="fl-wrap landing-band">
          <h3 class="fl-h2">Valores</h3>
          <div class="landing-values">
            {valores.map(({ titulo, texto }) => (
              <article>
                <h4>{titulo}</h4>
                <p>{texto}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="ubicacion" aria-labelledby="ubicacion-titulo">
      <div class="landing-location landing-location--city">
        <figure class="landing-photo">
          <img src="/tarapoto/cordillera-escalera-valle.webp" width="2200" height="1466" loading="lazy" decoding="async" alt="Montañas y bosque de la Cordillera Escalera, Tarapoto" />
        </figure>
        <div class="landing-copy landing-pattern">
          <p class="landing-label">Ubicación</p>
          <h2 id="ubicacion-titulo" class="fl-h2">Tarapoto, naturaleza y conexión</h2>
          <p>Una ciudad rodeada de naturaleza, con clima tropical, atractivos turísticos, actividad comercial y conectividad aérea.</p>
        </div>
      </div>
      <div class="fl-wrap landing-band landing-split landing-location--project">
        <figure class="landing-photo">
          <img src="/landing/acceso-principal.webp" width="1671" height="941" loading="lazy" decoding="async" alt="Acceso principal proyectado con pórtico y jardines" />
          <figcaption>Render referencial</figcaption>
        </figure>
        <div class="landing-copy">
          <h3 class="fl-h2">Flamingo Residencial, en una ubicación estratégica</h3>
          <p>Ubicado en jirón Cusco, frente al Club Cumbaza, con acceso a servicios urbanos y vistas a la Cordillera Escalera.</p>
          {googleMapsUrl
            ? <a class="fl-btn fl-btn--plum" href={googleMapsUrl} target="_blank" rel="noopener">Ver ubicación en Google Maps <span aria-hidden="true">↗</span></a>
            : <a class="fl-btn fl-btn--plum" href={whatsapp(contacto.central.raw, 'Hola, ¿podrían enviarme la ubicación de Flamingo Residencial?')} target="_blank" rel="noopener">Solicitar ubicación <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </section>

    <section id="proyecto" aria-labelledby="proyecto-titulo">
      <div class="landing-project-intro landing-pattern">
        <div class="fl-wrap landing-band landing-split">
          <div class="landing-copy">
            <p class="landing-label">El proyecto</p>
            <h2 id="proyecto-titulo" class="fl-h2">Conoce Flamingo Residencial</h2>
            <p>Un desarrollo residencial en Tarapoto que integra planificación urbana, formalidad, naturaleza y una propuesta arquitectónica con identidad propia.</p>
          </div>
          <figure class="landing-photo">
            <img src="/landing/vista-aerea.webp" width="1672" height="941" loading="lazy" decoding="async" alt="Vista aérea del conjunto proyectado, con las manzanas, vías y el parque central" />
            <figcaption>Render referencial</figcaption>
          </figure>
        </div>
      </div>

      <div class="landing-plum landing-pattern">
        <div class="fl-wrap landing-band">
          <div class="landing-copy landing-centered">
            <h3 class="fl-h2">Atributos que marcan la diferencia</h3>
            <p>Cada detalle de Flamingo Residencial responde a una planificación que integra formalidad y diseño urbano desde su origen, para dar forma a un entorno residencial pensado para el futuro.</p>
          </div>
          <div class="landing-attributes">
            {atributosLanding.map(({ icon, titulo, descripcion }) => (
              <article>
                <Icono name={icon} size={80} />
                <h4>{titulo}</h4>
                <p>{descripcion}</p>
              </article>
            ))}
          </div>
          <figure class="landing-photo landing-avenue">
            <img src="/landing/avenida-principal.webp" width="1672" height="941" loading="lazy" decoding="async" alt="Avenida principal proyectada con veredas, jardines y viviendas" />
            <figcaption>Render referencial</figcaption>
          </figure>
        </div>
      </div>

      <div id="master-plan" class="landing-plan landing-pattern" tabindex="-1">
        <div class="fl-wrap landing-band">
          <div class="landing-copy">
            <p class="landing-label">Master Plan Interactivo</p>
            <h3 class="fl-h2">Explora Flamingo Residencial</h3>
            <p>Selecciona la propiedad de tu interés, conoce su ubicación y características, y consulta su disponibilidad.</p>
          </div>
          <MasterPlan />
        </div>
      </div>

      <div class="landing-olive landing-pattern">
        <div class="fl-wrap landing-band landing-split landing-legal">
          <div class="landing-copy">
            <h3 class="fl-h2">¿Sabes qué significa tener habilitación urbana inscrita?</h3>
            <p>La habilitación urbana es el proceso mediante el cual un terreno se incorpora al uso urbano, conforme a los procedimientos y requisitos establecidos. Su inscripción registral permite identificar formalmente esa condición en SUNARP.</p>
            <p>Flamingo Residencial cuenta con habilitación urbana inscrita, un atributo relevante para quienes buscan conocer las condiciones urbanísticas del proyecto antes de invertir.</p>
            <details>
              <summary>Conoce más sobre nuestra habilitación urbana</summary>
              <p>La inscripción de la habilitación urbana y las partidas individuales corresponden a trámites distintos. La inscripción de la habilitación tampoco acredita que todas las obras estén terminadas.</p>
            </details>
          </div>
          <dl>
            {conceptos.map(({ titulo, texto }) => <div><dt>{titulo}</dt><dd>{texto}</dd></div>)}
          </dl>
        </div>
      </div>

      <div class="landing-location landing-location--experience landing-plum">
        <figure class="landing-photo">
          <img src="/landing/parque-central.webp" width="1671" height="941" loading="lazy" decoding="async" alt="Parque central proyectado con palmeras, jardines y espacios recreativos" />
          <figcaption>Render referencial</figcaption>
        </figure>
        <div class="landing-copy landing-pattern">
          <h3 class="fl-h2">Un entorno pensado para vivir</h3>
          <p>Un parque central, jardines, espacios recreativos y una propuesta arquitectónica que integra naturaleza, orden y armonía residencial.</p>
          <a href={visita} class="fl-btn fl-btn--solid">Agenda tu visita</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
